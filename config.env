# --- Project Zomboid ---
PZ_APPID=108600
PZ_INI=/root/Zomboid/Server/pzserver.ini

# --- SteamCMD ---
STEAMCMD=/usr/local/bin/steamcmd
# Workshop dir must match your *server install dir*, so downloads land where the server reads them.
# Default: dedicated server installed into /root/pzserver
STEAM_WORKSHOP_DIR=/root/pzserver/steamapps/workshop/content/108600

# --- Server start/stop (pzmanager) ---
SERVER_START=/opt/pzmanager/start-server-only.sh
SERVER_STOP=/opt/pzmanager/stop-server-only.sh

# --- Logs / rollback ---
SERVER_LOG=/root/Zomboid/Logs/server-console.txt
ROLLBACK_ON_ERRORS=1
# regex (python re) - co považujeme za fatální po startu
ROLLBACK_PATTERNS="missing mod|Mod .* not found|ERROR|Exception|failed to load|checksum|stack trace"

# --- Behaviour ---
STALE_DAYS_WARN=60
STALE_DAYS_FAIL=0

# Oddělovače do ini
SEP_WORKSHOP=";"
SEP_MODS=";"

# --- Auto MAP patch ---
AUTO_MAP=1
MAP_VANILLA="Muldraugh, KY"

# --- Conflicts / categories ---
RULES_FILE=/opt/starcore_rp_installer/rules/categories.json
STRICT_CATEGORIES=1

# --- Dependency auto-resolver (recommended ON)
# If enabled, the installer will try to auto-install Workshop items that provide missing
# required mod IDs ("require=") by searching Steam Workshop and validating by scanning mod.info.
RESOLVE_DEPS=1

# How many search result pages to scan per missing modId
DEPS_SEARCH_PAGES=3

# Max candidates to try download+scan per missing modId
DEPS_MAX_CANDIDATES=12

# Cache file for modId -> workshopId mapping (relative to this repo)
DEPS_CACHE_FILE=./rules/modid_map.json

DEP_HTTP_TIMEOUT=12
